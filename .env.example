# Browser (Vite) — these end up in the public bundle, so only publishable values.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Node scripts in scripts/ only — NEVER prefix with VITE_ or import from src/.
# The service-role key bypasses RLS.
SUPABASE_URL=
SERVICE_ROLE_KEY=

# LLM keys do not go here. Set them as Supabase secrets for the Edge Functions:
#   supabase secrets set LLM_API_KEY=...
